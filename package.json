{
  "name": "video-screenshot-generator-site-pm2-studio-night",
  "version": "17.0.0-native-original-frames",
  "private": true,
  "description": "Site-only local video screenshot generator with native/original-size PNG frame extraction locked by default; no downscale/resize unless explicitly enabled on the server.",
  "main": "server.js",
  "scripts": {
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart video-screenshot-site",
    "pm2:stop": "pm2 stop video-screenshot-site",
    "pm2:delete": "pm2 delete video-screenshot-site",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "fluent-ffmpeg": "^2.1.3"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}